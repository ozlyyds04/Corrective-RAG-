# 大语言模型（默认 DeepSeek 官方 API；兼容任意 OpenAI 风格接口）
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash-vision-exp



# 向量模型（默认千问 qwen3.7-text-embedding，走 DashScope 兼容接口）
EMBEDDING_MODEL=qwen3.7-text-embedding
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 网络搜索
TAVILY_API_KEY=

# Qdrant Cloud
QDRANT_URL=
QDRANT_API_KEY=

# 增量更新（文件监听）——仅本地开发需要；Docker 内 compose 会自动注入 REDIS_URL
# REDIS_URL=redis://localhost:6379/0
# WATCH_DIR=D:\docs
# WATCH_KB=默认

# Docker 宿主机挂载（让容器里的后端能读取本地文档目录）
# 例：HOST_MOUNT_PATH=D:\Desktop 时，界面填 D:\Desktop\Agent八股 会自动映射到 /host/docs/Agent八股
HOST_MOUNT_PATH=
CONTAINER_MOUNT_PATH=/host/docs

# 生成上下文的最大 token 预算（超过则按重排分数择优保留并截断）
MAX_CONTEXT_TOKENS=2600

# 安全：若设置 API_TOKEN，除 /api/health、/api/config 外所有接口都需带 Bearer / X-API-Token 头
# （同时会关闭 /docs 交互文档，避免接口定义绕过鉴权暴露）
# API_TOKEN=
# 允许跨域的来源（逗号分隔），默认覆盖本机开发端口
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8081
# 调试：为 1 时把具体错误信息返回给前端（否则只返回错误类型）
APP_DEBUG=0
