# 大语言模型（默认 DeepSeek 官方 API；兼容任意 OpenAI 风格接口）
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash-vision-exp



# 向量模型（默认千问 qwen3.7-text-embedding，走 DashScope 兼容接口）
EMBEDDING_MODEL=qwen3.7-text-embedding
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 网络搜索
TAVILY_API_KEY=

# Qdrant Cloud
QDRANT_URL=
QDRANT_API_KEY=

# 增量更新（文件监听）——仅本地开发需要；Docker 内 compose 会自动注入 REDIS_URL
# REDIS_URL=redis://localhost:6379/0
# WATCH_DIR=D:\docs
# WATCH_KB=默认
